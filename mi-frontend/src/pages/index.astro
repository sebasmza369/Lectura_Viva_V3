---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="es">
	<head>
		<meta charset="utf-8" />		
		<meta name="viewport" content="width=device-width" />		
		<title>Lectura Viva</title>
	</head>
	<body>

		<Nav />
		
		<main>

			 <img
				class="hero-imagen"
				src="/images/inicio.jpg"
				alt="Libro abierto sobre una mesa con sus páginas en forma de corazón "
			/>

 			<section class="hero">
				<p class="hero-etiqueta">LECTURA VIVA</p>

				<h1>Encuentra tu próxima lectura</h1>

				<p class="hero-texto">
					Descubre libros, explora diferentes géneros
					y encuentra nuevas historias para leer.
				</p>

				<a class="hero-boton" href="/catalogo">
					Explorar catálogo
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
